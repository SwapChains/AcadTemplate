---
// Mostra a foto src/assets/raw/<name>.(jpg|png|webp|avif) otimizada (AVIF/WebP + srcset).
// Se o arquivo ainda não existir, desenha um placeholder estilizado no lugar,
// então basta soltar a foto na pasta com o nome certo para ela aparecer.
//
// `mobileName` (opcional): foto alternativa para telas em retrato. Cada aparelho
// baixa só a versão que vai exibir.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  mobileName?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  name,
  alt,
  mobileName,
  widths = [480, 800, 1200],
  sizes = '100vw',
  priority = false,
  class: className,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/raw/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}', {
  eager: true,
});
const find = (n?: string) =>
  n ? Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.[^.]+$/, '') === n)?.[1].default : undefined;

const image = find(name);
const mobile = find(mobileName);
// Tamanhos do srcset que cabem na foto original (+ a própria largura dela, se for menor que o maior pedido).
const fit = (img: ImageMetadata) => {
  const w = widths.filter((x) => x < img.width);
  return w.length < widths.length ? [...w, img.width] : w;
};
const loading = priority ? 'eager' : 'lazy';

// Art direction: <picture> com <source media> para retrato.
let art: { sources: { media?: string; type: string; srcset: string }[]; fallback: string; w: number; h: number } | undefined;
if (image && mobile) {
  const portrait = '(max-aspect-ratio: 4/5)';
  const sources = [];
  for (const [img, media] of [[mobile, portrait], [image, undefined]] as const) {
    for (const format of ['avif', 'webp'] as const) {
      const r = await getImage({ src: img, widths: fit(img), format });
      sources.push({ media, type: `image/${format}`, srcset: r.srcSet.attribute });
    }
  }
  const fb = await getImage({ src: image, width: Math.min(1600, image.width), format: 'jpg' });
  art = { sources, fallback: fb.src, w: image.width, h: image.height };
}
---

<div class:list={['media', className, { 'media--ph': !image }]}>
  {
    art ? (
      <picture>
        {art.sources.map((s) => <source media={s.media} type={s.type} srcset={s.srcset} sizes={sizes} />)}
        <img src={art.fallback} alt={alt} width={art.w} height={art.h} loading={loading} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
      </picture>
    ) : image ? (
      <Picture
        src={image}
        alt={alt}
        widths={fit(image)}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={loading}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    ) : (
      <div class="ph" role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h3l1.5-2h7L17 7h3v12H4z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          <circle cx="12" cy="13" r="3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <span>{name}</span>
      </div>
    )
  }
</div>

<style>
  .media { position: relative; overflow: hidden; background: var(--c-surface); }
  .media :global(picture), .media :global(img) { display: block; width: 100%; height: 100%; }
  .media :global(img) { object-fit: cover; }

  .ph {
    position: absolute; inset: 0;
    display: grid; place-content: center; justify-items: center; gap: 0.6rem;
    color: color-mix(in srgb, var(--c-fg) 35%, transparent);
    background:
      radial-gradient(120% 80% at 20% 10%, color-mix(in srgb, var(--c-accent) 14%, transparent), transparent 60%),
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(255 255 255 / 0.025) 14px 15px),
      linear-gradient(160deg, var(--c-surface-2), var(--c-bg));
  }
  .ph svg { width: 2.25rem; height: 2.25rem; }
  .ph span { font: 500 0.7rem/1 ui-monospace, monospace; letter-spacing: 0.08em; text-transform: uppercase; }
</style>
