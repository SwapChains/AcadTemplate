---
import Media from './Media.astro';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { team } from '../data/site';
---

<section class="section" id="equipe">
  <div class="container">
    <SectionHeader eyebrow="Equipe" title="Quem treina você" text="Professores formados, com registro no CREF e anos de experiência em sala." />
    <ul class="grid">
      {team.map((p, i) => (
        <li class="person" data-reveal="zoom" style={`--i:${i}`}>
          <div class="photo">
            <Media name={p.image} alt={`Foto de ${p.name}`} widths={[320, 480, 720]} sizes="(max-width: 760px) 50vw, 25vw" />
            <a class="ig" href={p.instagram} target="_blank" rel="noopener" aria-label={`Instagram de ${p.name}`}>
              <Icon name="instagram" />
            </a>
          </div>
          <h3>{p.name}</h3>
          <p class="role">{p.role}</p>
          <p class="cref">{p.cref}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  .photo { position: relative; aspect-ratio: 3 / 4; border-radius: var(--radius); overflow: hidden; margin-bottom: 1rem; }
  .photo :global(.media) { position: absolute; inset: 0; }
  .photo :global(img) { filter: grayscale(1) contrast(1.05); transition: filter 0.6s, scale 0.8s var(--ease-out); }
  .person:hover .photo :global(img) { filter: grayscale(0); scale: 1.05; }
  .photo::after {
    content: ''; position: absolute; inset: auto 0 0; height: 4px; background: var(--c-accent);
    transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease-out);
  }
  .person:hover .photo::after { transform: scaleX(1); }
  .ig {
    position: absolute; top: 0.75rem; right: 0.75rem; display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    background: var(--c-accent); color: var(--c-accent-fg);
    opacity: 0; scale: 0.6; transition: opacity 0.3s, scale 0.4s var(--ease-out);
  }
  .ig :global(svg) { width: 1.2rem; height: 1.2rem; }
  .person:hover .ig, .ig:focus-visible { opacity: 1; scale: 1; }
  @media (hover: none) { .ig { opacity: 1; scale: 1; } }
  h3 { font-size: 1.15rem; }
  .role { color: var(--c-accent); font-size: 0.9rem; font-weight: 500; }
  .cref { color: var(--c-muted); font-size: 0.8rem; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
