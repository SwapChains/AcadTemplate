---
import Media from './Media.astro';
import SectionHeader from './SectionHeader.astro';
import { structure } from '../data/site';
---

<section class="section structure" id="estrutura">
  <div class="container">
    <SectionHeader eyebrow="Estrutura" title={structure.title} text={structure.text} />
    <ul class="mosaic">
      {structure.images.map((img, i) => (
        <li class={`tile tile--${i + 1}`} data-reveal="zoom" style={`--i:${i % 3}`}>
          <Media name={img.image} alt={img.alt} widths={[400, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" />
          <span class="cap">{img.alt}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .mosaic {
    display: grid; gap: 1rem;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(9rem, 16vw, 14rem);
  }
  .tile { position: relative; border-radius: var(--radius); overflow: hidden; }
  .tile :global(.media) { position: absolute; inset: 0; }
  .tile :global(img) { filter: grayscale(1); transition: filter 0.6s, scale 0.8s var(--ease-out); }
  .tile:hover :global(img) { filter: grayscale(0); scale: 1.05; }
  .tile--1 { grid-column: span 2; grid-row: span 2; }
  .tile--4 { grid-column: span 2; }
  .tile--5, .tile--6 { grid-column: span 2; }

  /* Parallax sutil por tile, só onde há suporte a scroll-driven animations */
  @supports (animation-timeline: view()) {
    .tile :global(.media) { inset: -8% 0; animation-name: drift; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); }
    @keyframes drift { from { translate: 0 -6%; } to { translate: 0 6%; } }
  }

  .cap {
    position: absolute; left: 0.75rem; bottom: 0.75rem;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em;
    padding: 0.35rem 0.7rem; border-radius: 99px;
    background: rgb(0 0 0 / 0.55); backdrop-filter: blur(6px);
    opacity: 0; translate: 0 0.5rem; transition: opacity 0.3s, translate 0.3s var(--ease-out);
  }
  .tile:hover .cap { opacity: 1; translate: 0 0; }

  @media (max-width: 760px) {
    .mosaic { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 9rem; }
    .tile--1 { grid-row: span 2; }
    .tile--4, .tile--5 { grid-column: span 1; }
    .tile--6 { grid-column: span 2; }
    .cap { opacity: 1; translate: 0 0; }
  }
</style>
