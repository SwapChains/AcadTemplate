---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, whatsappLink } from '../data/site';
---

<header class="site-header" data-header>
  <div class="container bar">
    <Logo />

    <nav class="nav" id="site-nav" aria-label="Principal">
      <ul>
        {nav.map((item, i) => (
          <li style={`--n:${i}`}><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn nav-cta" href={whatsappLink()} target="_blank" rel="noopener">Aula grátis</a>
    </nav>

    <a class="btn header-cta" href={whatsappLink()} target="_blank" rel="noopener">Aula grátis</a>

    <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Abrir menu" data-menu-btn>
      <Icon name="menu" class="i-open" />
      <Icon name="close" class="i-close" />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50;
    transition: background 0.4s, border-color 0.4s, backdrop-filter 0.4s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--c-bg) 75%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-color: var(--c-line);
  }
  .bar { display: flex; align-items: center; gap: 2rem; height: 4.75rem; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 2rem; }
  .nav a:not(.btn) {
    text-decoration: none; font-weight: 500; font-size: 0.95rem; color: var(--c-muted);
    position: relative; transition: color 0.2s;
  }
  .nav a:not(.btn)::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.35rem; height: 2px;
    background: var(--c-accent); transform: scaleX(0); transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }
  .nav a:not(.btn):hover { color: var(--c-fg); }
  .nav a:not(.btn):hover::after { transform: scaleX(1); transform-origin: left; }
  .nav-cta { display: none; }
  .header-cta { padding: 0.7rem 1.25rem; font-size: 0.9rem; }

  .menu-btn { display: none; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: 50%; border: 1px solid var(--c-line); }
  .menu-btn :global(svg) { width: 1.3rem; height: 1.3rem; grid-area: 1 / 1; transition: opacity 0.2s, rotate 0.3s var(--ease-out); }
  .menu-btn :global(.i-close) { opacity: 0; rotate: -90deg; }
  [data-open] .menu-btn :global(.i-open) { opacity: 0; rotate: 90deg; }
  [data-open] .menu-btn :global(.i-close) { opacity: 1; rotate: 0deg; }

  @media (max-width: 900px) {
    .header-cta { display: none; }
    .menu-btn { display: grid; margin-left: auto; z-index: 2; }
    .nav {
      position: fixed; inset: 0; margin: 0;
      display: flex; flex-direction: column; justify-content: center; gap: 2.5rem;
      padding: var(--gutter);
      background: var(--c-bg);
      clip-path: circle(0 at calc(100% - 2.75rem) 2.4rem);
      transition: clip-path 0.6s var(--ease-out), visibility 0s 0.6s;
      visibility: hidden;
    }
    [data-open] .nav { clip-path: circle(150% at calc(100% - 2.75rem) 2.4rem); visibility: visible; transition-delay: 0s; }
    .nav ul { flex-direction: column; gap: 0.5rem; }
    .nav li { opacity: 0; translate: 0 1rem; transition: opacity 0.4s, translate 0.4s var(--ease-out); }
    [data-open] .nav li { opacity: 1; translate: 0 0; transition-delay: calc(0.15s + var(--n) * 0.05s); }
    .nav a:not(.btn) {
      font-family: var(--f-display); font-weight: 800; font-stretch: 75%; text-transform: uppercase;
      font-size: clamp(2.5rem, 11vw, 4rem); line-height: 1.1; color: var(--c-fg);
    }
    .nav a:not(.btn)::after { display: none; }
    .nav-cta { display: inline-flex; align-self: flex-start; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;

  const onScroll = () => header.classList.toggle('is-scrolled', scrollY > 30);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 901px)').addEventListener('change', () => setOpen(false));
</script>
