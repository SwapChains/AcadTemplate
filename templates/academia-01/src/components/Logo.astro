---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<a class="logo" href={base} aria-label={`${site.name} ${site.tagline} — início`}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="var(--c-accent)" />
    <path d="M9 8h14v4h-9v3h8v4h-8v5H9z" fill="var(--c-accent-fg)" />
  </svg>
  <span class="display">{site.name}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  svg { width: 2rem; height: 2rem; transition: transform 0.4s var(--ease-out); }
  .logo:hover svg { transform: rotate(-8deg) scale(1.05); }
  span { font-size: 1.6rem; letter-spacing: 0.02em; }
</style>
