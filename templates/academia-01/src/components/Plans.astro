---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { plans, whatsappLink } from '../data/site';

const msg = (name: string, period: string) => `Olá! Tenho interesse no plano ${name} (${period}).`;
---

<section class="section plans" id="planos">
  <div class="container">
    <SectionHeader eyebrow="Planos" title="Sem letra miúda" text="Escolha o plano ideal para sua rotina. Sem taxa de matrícula no anual." align="center">
      <div class="toggle" role="group" aria-label="Período de cobrança" data-reveal style="--i:3" data-period-toggle>
        <button type="button" aria-pressed="true" data-period="monthly">Mensal</button>
        <button type="button" aria-pressed="false" data-period="annual">Anual <span class="save">-20%</span></button>
        <span class="thumb" aria-hidden="true"></span>
      </div>
    </SectionHeader>

    <ul class="grid">
      {plans.items.map((p, i) => (
        <li class:list={['plan', { 'plan--featured': p.featured }]} data-reveal style={`--i:${i}`} data-glow>
          {p.featured && <span class="tag">Mais escolhido</span>}
          <h3 class="display">{p.name}</h3>
          <p class="text">{p.text}</p>
          <p class="price" aria-live="polite">
            <span class="cur">R$</span>
            <span class="amount display" data-monthly={p.monthly} data-annual={p.annual}>{p.monthly}</span>
            <span class="per">/mês<span class="note" hidden>{plans.annualNote}</span></span>
          </p>
          <ul class="features">
            {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
          </ul>
          <a
            class:list={['btn', { 'btn--ghost': !p.featured }]}
            href={whatsappLink(msg(p.name, 'mensal'))}
            data-msg-monthly={whatsappLink(msg(p.name, 'mensal'))}
            data-msg-annual={whatsappLink(msg(p.name, 'anual'))}
            target="_blank" rel="noopener"
          >
            Quero o {p.name} <Icon name="arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .toggle {
    position: relative; display: inline-grid; grid-template-columns: 1fr 1fr;
    padding: 0.3rem; border-radius: 99px; border: 1px solid var(--c-line); background: var(--c-surface);
    margin-top: 0.5rem;
  }
  .toggle button { position: relative; z-index: 1; padding: 0.6rem 1.4rem; border-radius: 99px; font-weight: 600; color: var(--c-muted); transition: color 0.3s; }
  .toggle button[aria-pressed='true'] { color: var(--c-accent-fg); }
  .thumb { position: absolute; inset: 0.3rem auto 0.3rem 0.3rem; width: calc(50% - 0.3rem); border-radius: 99px; background: var(--c-accent); transition: translate 0.4s var(--ease-out); }
  .toggle[data-annual] .thumb { translate: 100% 0; }
  .save { font-size: 0.75em; opacity: 0.8; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; align-items: stretch; }
  .plan {
    --x: 50%; --y: 0%;
    position: relative; display: flex; flex-direction: column; gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.5rem); border-radius: calc(var(--radius) * 1.5);
    border: 1px solid var(--c-line);
    background:
      radial-gradient(400px circle at var(--x) var(--y), color-mix(in srgb, var(--c-accent) 9%, transparent), transparent 60%),
      var(--c-surface);
    transition: border-color 0.3s, translate 0.4s var(--ease-out);
  }
  .plan:hover { border-color: color-mix(in srgb, var(--c-accent) 40%, var(--c-line)); }
  .plan--featured { border-color: var(--c-accent); }
  /* transform (e não translate) para não brigar com a animação de reveal */
  @media (min-width: 901px) { .plan--featured { transform: translateY(-1rem); } }
  .tag {
    position: absolute; top: -0.8rem; left: 50%; translate: -50% 0;
    background: var(--c-accent); color: var(--c-accent-fg);
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    padding: 0.35rem 0.9rem; border-radius: 99px; white-space: nowrap;
  }
  h3 { font-size: 2.2rem; }
  .text { color: var(--c-muted); font-size: 0.95rem; }
  @media (min-width: 901px) { .text { min-height: 3.2em; } } /* alinha os preços entre os cards */
  .price { display: flex; align-items: baseline; gap: 0.3rem; padding-block: 0.5rem 1rem; border-bottom: 1px solid var(--c-line); }
  .cur { color: var(--c-muted); font-weight: 600; }
  .amount { font-size: clamp(3.5rem, 6vw, 4.5rem); display: inline-block; font-variant-numeric: tabular-nums; }
  .amount.flip { animation: flip 0.45s var(--ease-out); }
  @keyframes flip { 0% { opacity: 0; translate: 0 -40%; } 100% { opacity: 1; translate: 0 0; } }
  .per { color: var(--c-muted); display: grid; line-height: 1.2; }
  .note { font-size: 0.75rem; }
  .features { display: grid; gap: 0.7rem; flex: 1; }
  .features li { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.95rem; }
  .features :global(svg) { width: 1.15rem; height: 1.15rem; flex: none; margin-top: 0.2rem; color: var(--c-accent); }
  .plan .btn { margin-top: 0.5rem; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; max-width: 28rem; margin-inline: auto; gap: 1.5rem; }
    .plan--featured { order: -1; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLElement>('[data-period-toggle]');
  if (toggle) {
    const buttons = toggle.querySelectorAll<HTMLButtonElement>('button');
    const section = toggle.closest('section')!;
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const annual = b.dataset.period === 'annual';
        if (toggle.hasAttribute('data-annual') === annual) return;
        toggle.toggleAttribute('data-annual', annual);
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        section.querySelectorAll<HTMLElement>('.amount').forEach((el) => {
          el.textContent = (annual ? el.dataset.annual : el.dataset.monthly)!;
          el.classList.remove('flip');
          void el.offsetWidth; // reinicia a animação
          el.classList.add('flip');
        });
        section.querySelectorAll<HTMLElement>('.note').forEach((n) => (n.hidden = !annual));
        section.querySelectorAll<HTMLAnchorElement>('[data-msg-monthly]').forEach((a) => {
          a.href = (annual ? a.dataset.msgAnnual : a.dataset.msgMonthly)!;
        });
      }),
    );
  }

  // Brilho que segue o cursor nos cards (só com mouse).
  if (matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('[data-glow]').forEach((card) =>
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--x', `${e.clientX - r.left}px`);
        card.style.setProperty('--y', `${e.clientY - r.top}px`);
      }),
    );
  }
</script>
