---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { testimonials } from '../data/site';

const initials = (name: string) => name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---

<section class="section testimonials" id="depoimentos">
  <div class="container">
    <SectionHeader eyebrow="Depoimentos" title="Quem treina, recomenda" align="center" />
  </div>

  <div class="rail">
    {[0, 1].map((copy) => (
      <ul class="track" aria-hidden={copy === 1 ? 'true' : undefined}>
        {testimonials.map((t) => (
          <li class="card">
            <div class="stars" aria-label="5 de 5 estrelas" role="img">
              {[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}
            </div>
            <blockquote>“{t.text}”</blockquote>
            <footer>
              <span class="avatar" aria-hidden="true">{initials(t.name)}</span>
              <span><strong>{t.name}</strong><small>{t.since}</small></span>
            </footer>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .rail {
    display: flex; overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .track { display: flex; gap: 1rem; padding-right: 1rem; flex: none; animation: slide 60s linear infinite; }
  .rail:hover .track { animation-play-state: paused; }
  @keyframes slide { to { translate: -100% 0; } }

  .card {
    width: clamp(18rem, 30vw, 24rem); flex: none;
    display: flex; flex-direction: column; gap: 1.25rem;
    padding: 1.75rem; border-radius: calc(var(--radius) * 1.25);
    background: var(--c-surface); border: 1px solid var(--c-line);
  }
  .stars { display: flex; gap: 0.2rem; color: var(--c-accent); }
  .stars :global(svg) { width: 1rem; height: 1rem; }
  blockquote { font-size: 1.05rem; line-height: 1.55; flex: 1; }
  footer { display: flex; align-items: center; gap: 0.8rem; }
  .avatar {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--c-surface-2); color: var(--c-accent); font-weight: 700; border: 1px solid var(--c-line);
  }
  footer span:last-child { display: grid; line-height: 1.3; }
  small { color: var(--c-muted); font-size: 0.82rem; }

  @media (prefers-reduced-motion: reduce) {
    .rail { overflow-x: auto; mask-image: none; padding-inline: var(--gutter); }
    .track[aria-hidden] { display: none; }
  }
</style>
